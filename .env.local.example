# Copy this file to .env.local. The anon key is in js/database.js of your current storefront.
# These have no NEXT_PUBLIC_ prefix on purpose, so they stay on the server.
SUPABASE_URL=https://xpndtrzupejchgsufpaa.supabase.co
# Preferred server key: used by the order API and the Meta catalog feed. Never expose it.
SUPABASE_SECRET_KEY=paste-your-service-key-here
# Fallback if the secret key is not available (may be limited by Row Level Security).
SUPABASE_ANON_KEY=paste-your-anon-key-here

# Optional. Product images stored as paths like "images/rolex.jpg" are served from this app's /public folder.
# To load them from your existing site instead, set its address here (no trailing slash).
# PRODUCT_IMAGE_BASE_URL=https://your-current-site.com

# --- Admin dashboard session ------------------------------------------------
# Signs the HttpOnly cookie used by the /api/dashboard routes. Optional: when it
# is empty the server falls back to SUPABASE_SECRET_KEY, so rotating that key
# also invalidates admin sessions. Set it explicitly to rotate them separately.
# AUTH_SECRET=generate-a-long-random-string

# --- Meta catalog feed (D2) -------------------------------------------------
# Long random string. Meta stores the full feed URL, including this token.
META_FEED_TOKEN=generate-a-long-random-string
# Public origin used for product links and image URLs in the feed.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional feed defaults.
# META_FEED_LOCALE=ar
# META_FEED_BRAND=Zen Watches
# META_FEED_CURRENCY=DZD

# --- Meta Pixel + Conversions API (D5-D7) ----------------------------------
# Public Pixel (dataset) id from Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only Conversions API token. Never expose it with NEXT_PUBLIC_.
META_CAPI_TOKEN=
# Test events only. Remove this in production or events will not count.
# META_TEST_EVENT_CODE=
# Optional Graph API version override.
# META_GRAPH_VERSION=v26.0

# --- Cookie consent (D9) ---------------------------------------------------
# Set to true to show the consent banner and load the Pixel only after acceptance.
NEXT_PUBLIC_META_CONSENT_REQUIRED=false
